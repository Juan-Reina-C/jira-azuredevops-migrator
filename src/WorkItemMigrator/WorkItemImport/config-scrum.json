      },
      {
        "source": "status",
        "target": "System.State",
        "for": "Epic,Feature",
        "mapping": {
          "values": [
            {
              "source": "To do",
              "target": "New"
            },
            {
              "source": "To Do",
              "target": "New"
            },
            {
