              "target": "New"
            },
            {
              "source": "On hold",
              "target": "New"
            },
            {
              "source": "In Progress",
              "target": "Committed"
            },
            {
              "source": "READY FOR TESTING",
              "target": "Committed"
            },
            {
              "source": "CODE REVIEW",
              "target": "Committed"
            },
            {
              "source": "QA TESTING",
              "target": "Committed"
            },
            {
              "source": "READY TO DELIVERY",
              "target": "Committed"
