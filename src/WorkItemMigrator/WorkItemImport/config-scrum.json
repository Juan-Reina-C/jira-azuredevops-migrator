            {
              "source": "On dev",
              "target": "In Progress"
            },
            {
              "source": "Ready for staging",
              "target": "In Progress"
            }
          ]
        }
      },
      {
        "source": "status",
        "target": "System.State",
        "for": "Bug",
        "mapping": {
          "values": [
            {
              "source": "To do",
              "target": "New"
            },
            {
              "source": "To Do",
              "target": "New"
            },
            {
              "source": "Done",
              "target": "Closed"
            },
            {
              "source": "CLOSED",
              "target": "Closed"
            },
            {
              "source": "RESOLVED",
              "target": "Closed"
            },
            {
              "source": "CLOSE - TO DELETE",
              "target": "Done"
            },
            {
              "source": "CODE REVIEW",
              "target": "New"
            },
            {
              "source": "On hold",
              "target": "New"
            },
            {
              "source": "In Progress",
              "target": "Committed"
            },
            {
              "source": "READY FOR TESTING",
              "target": "Committed"
            },
            {
              "source": "CODE REVIEW",
              "target": "Committed"
            },
            {
              "source": "QA TESTING",
              "target": "Committed"
            },
            {
              "source": "READY TO DELIVERY",
              "target": "Done"
