            },
            {
              "source": "Ready for production",
              "target": "Committed"
            },
            {
              "source": "CODE REVIEW - TO DELETE",
              "target": "Committed"
            },
            {
              "source": "RESOLVED - TO DELETE",
              "target": "Done"
            },
            {
              "source": "CLOSED - TO DELETE",
              "target": "Done"
            },
            {
              "source": "READY TO PRODUCTION",
              "target": "Committed"
            },
            {
              "source": "In progress",
              "target": "Committed"
            },
            {
              "source": "Ready to production",
              "target": "Committed"
            },
            {
              "source": "DONE",
              "target": "Done"
            }
          ],
          "whenNotSet": { "value": "Done" } 
        }
      },
      {
        "source": "status",
        "target": "System.State",
        "for": "Product Backlog Item, Story",
        "mapping": {
          "values": [
            {
              "source": "To do",
              "target": "New"
            },
            {
              "source": "To Do",
              "target": "New"
